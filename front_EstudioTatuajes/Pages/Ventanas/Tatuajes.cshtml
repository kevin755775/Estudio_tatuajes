@page
@model TatuajesModel
@{
    ViewData["Title"] = "Tatuajes";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Tatuajes</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flZonaCuerpo"
                   placeholder="ZonaCuerpo"
                   asp-for="@Model.Filtro!.ZonaCuerpo" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Tatuajes</h3>

                <label>
                    ZonaCuerpo
                </label>
                <input asp-for="@Model.Actual!.ZonaCuerpo" />
                <br />

                <label>
                    Ancho
                </label>
                <input asp-for="@Model.Actual!.Ancho" />
                <br />

                <label>
                    Alto
                </label>
                <input asp-for="@Model.Actual!.Alto" />
                <br />

                <label>
                    Color
                </label>
                <input asp-for="@Model.Actual!.Color" />
                <br />

                <label>
                    Estilo Tatuaje -Nombre
                </label>
                <select id="nmEstiloTatuaje"
                        asp-for="@Model.Actual!.EstiloTatuaje"
                        asp-items="@(new SelectList(Model.EstilosTatuajes, "Id", "Nombre"))">
                </select>
                <br />
                <label>
                    Imagen Tatuajes
                </label>
                @if (Model.Actual!.ImagenTatuajes != null)
                {
                    <img height="100"
                         width="100"
                         src="data:image;base64,
                        @System.Convert.ToBase64String(
                        Convert.FromBase64String(
                        Model.Actual!.ImagenTatuajes))" />
                }
                <input type="file"
                       asp-for="FormFile" />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el tatuaje con información ID:
                        @Model.Actual!.Id,
                        ZonaCuerpo: @Model.Actual!.ZonaCuerpo
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>ZonaCuerpo</th>
                        <th>Ancho</th>
                        <th>Alto</th>
                        <th>Color</th>
                        <th>EstiloTatuaje</th>
                        <th>ImagenTatuajes</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.ZonaCuerpo</td>
                                <td>@elemento.Ancho</td>
                                <td>@elemento.Alto</td>
                                <td>@elemento.Color</td>
                                <td>@elemento._EstiloTatuaje?.Nombre</td>
                                <td>
                                            @if (elemento.ImagenTatuajes != null)
                                            {
                                                <img height="60"
                                                     width="60"
                                                     src="data:image;base64,
                                                @System.Convert.ToBase64String(
                                                Convert.FromBase64String(elemento.ImagenTatuajes))" />
                                    }
                                </td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
