@page
@model ImplementosModel
@{
    ViewData["Title"] = "Implementos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Implementos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flNombre"
                   placeholder="Nombre"
                   asp-for="@Model.Filtro!.Nombre" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Implementos</h3>

                <label>
                    Nombre
                </label>
                <input asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Precio
                </label>
                <input asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    Stock
                </label>
                <input asp-for="@Model.Actual!.Stock" />
                <br />

                <label>
                    Marca
                </label>
                <input asp-for="@Model.Actual!.Marca" />
                <br />

                <label>
                    Proveedores - NombreEmpresa
                </label>
                <select id="nmProveedor"
                        asp-for="@Model.Actual!.Proveedores"
                        asp-items="@(new SelectList(Model.Proveedores, "Id", "NombreEmpresa"))">
                </select>
                <br />

                <label>
                    Sede -Nombre
                </label>
                <select id="nmPersona"
                        asp-for="@Model.Actual!.Sede"
                        asp-items="@(new SelectList(Model.Sedes, "Id", "Nombre"))">
                </select>
                <br />

                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Implemento con información ID:
                        @Model.Actual!.Id,
                        Nombre @Model.Actual!.Nombre,
                        Precio @Model.Actual!.Precio?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Nombre </th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Marca</th>
                        <th>Proveedores </th>
                        <th>Sede</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Precio</td>
                                <td>@elemento.Stock</td>
                                <td>@elemento.Marca</td>
                                <td>@elemento._Proveedores.NombreEmpresa</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>