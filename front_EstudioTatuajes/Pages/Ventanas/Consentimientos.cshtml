@page
@model ConsentimientosModel
@{
    ViewData["Title"] = "Consentimientos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Consentimientos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flObservaciones"
                   placeholder="Observaciones"
                   asp-for="@Model.Filtro!.Observaciones" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Consentimientos</h3>

                <label>
                    FechaFirma
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.FechaFirma" />
                <br />

                <label>
                    Mayor de edad
                </label>
                <input asp-for="@Model.Actual!.MayorEdad" />
                <br />
                <label>
                    Firmo Si o No
                </label>
                <input asp-for="@Model.Actual!.FirmaSiNo" />
                <br />
                <label>
                    Observaciones
                </label>
                <input asp-for="@Model.Actual!.Observaciones" />
                <br />

                

                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Cliente con información ID:
                        @Model.Actual!.Id,
                        FirmaSiNo @Model.Actual!.FirmaSiNo,
                        MayorEdad @Model.Actual!.MayorEdad?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>FechaFirma </th>
                        <th>MayorEdad</th>
                        <th>FirmaSiNo</th>
                        <th>Observaciones</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.FechaFirma</td>
                                <td>@elemento.MayorEdad</td>
                                <td>@elemento.FirmaSiNo</td>
                                <td>@elemento.Observaciones</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>