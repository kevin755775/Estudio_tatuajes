@page
@model PagosModel
@{
    ViewData["Title"] = "Pagos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Pagos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flReferencia"
                   placeholder="Referencia"
                   asp-for="@Model.Filtro!.Referencia" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Pagos</h3>

                <label>
                    MetodoPago
                </label>
                <input asp-for="@Model.Actual!.MetodoPago" />
                <br />

                <label>
                    Valor
                </label>
                <input asp-for="@Model.Actual!.Valor" />
                <br />

                <label>
                    Fecha
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Referencia
                </label>
                <input asp-for="@Model.Actual!.Referencia" />
                <br />

                
                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Pago con información ID:
                        @Model.Actual!.Id,
                        Referencia @Model.Actual!.Referencia,
                        Valor @Model.Actual!.Valor?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>MetodoPago </th>
                        <th>Valor</th>
                        <th>Fecha</th>
                        <th>Referencia</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.MetodoPago</td>
                                <td>@elemento.Valor</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Referencia</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>