@page
@model SedesModel
@{
    ViewData["Title"] = "Sedes";
    var rol = HttpContext.Session.GetString("Rol");
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Sedes</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            @if (rol == "Administrador" || rol == "Recepcionista")
            {
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar" />
            }
            <input id="flNombre"
                   placeholder="Nombre"
                   asp-for="@Model.Filtro!.Nombre" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Sedes</h3>

                <label>
                    Nombre
                </label>
                <input asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Direccion
                </label>
                <input asp-for="@Model.Actual!.Direccion" />
                <br />

                <label>
                    Telefono
                </label>
                <input asp-for="@Model.Actual!.Telefono" />
                <br />

                <label>
                    Ciudad
                </label>
                <input asp-for="@Model.Actual!.Ciudad" />
                <br />

                <label>
                    Imagen Sedes
                </label>
                @if (Model.Actual!.ImagenSedes != null)
                {
                    <img height="100"
                         width="100"
                         src="data:image;base64,
                    @System.Convert.ToBase64String(
                    Convert.FromBase64String(
                    Model.Actual!.ImagenSedes))" />
                }
                <input type="file"
                       asp-for="FormFile" />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la sede con información ID:
                        @Model.Actual!.Id,
                        Nombre: @Model.Actual!.Nombre,
                        Direccion: @Model.Actual!.Direccion
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Nombre </th>
                        <th>Direccion</th>
                        <th>Telefono</th>
                        <th>Ciudad</th>
                        <th>ImagenSedes</th>

                        <th>Acción</th>
                        
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Direccion</td>
                                <td>@elemento.Telefono</td>
                                <td>@elemento.Ciudad</td>

                                <td>
                                    @if (elemento.ImagenSedes != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                        @System.Convert.ToBase64String(
                                        Convert.FromBase64String(elemento.ImagenSedes))" />
                                    }
                                </td>
                                <td>

                                    @if (rol == "Administrador" || rol == "Recepcionista")
                                    {
                                        <input type="submit"
                                               value="Editar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                    @if (rol == "Administrador")
                                    {
                                        <input type="submit"
                                               value="Borrar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>