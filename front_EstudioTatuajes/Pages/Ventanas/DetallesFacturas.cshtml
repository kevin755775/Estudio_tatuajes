@page
@model DetallesFacturasModel
@{
    ViewData["Title"] = "DetallesFacturas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Detalles de Facturas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flSubtotal"
                   placeholder="Subtotal"
                   asp-for="@Model.Filtro!.Subtotal" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalles de Facturas</h3>

                <label>
                    Cantidad
                </label>
                <input asp-for="@Model.Actual!.Cantidad" />
                <br />

                <label>
                    Precio Unitario
                </label>
                <input asp-for="@Model.Actual!.PrecioUnitario" />
                <br />

                <label>
                    Subtotal
                </label>
                <input asp-for="@Model.Actual!.Subtotal" />
                <br />

                <label>
                    Factura -Total
                </label>
                <select id="nmFactura"
                        asp-for="@Model.Actual!.Factura"
                        asp-items="@(new SelectList(Model.Facturas, "Id", "Total"))">
                </select>
                <br />

                <label>
                    Producto -Nombre
                </label>
                <select id="nmProducto"
                        asp-for="@Model.Actual!.Producto"
                        asp-items="@(new SelectList(Model.ProductosVentas, "Id", "Nombre"))">
                </select>
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Detalle de factura con información ID:
                        @Model.Actual!.Id,
                        Cantidad @Model.Actual!.Cantidad,
                        Subtotal @Model.Actual!.Subtotal?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Cantidad </th>
                        <th>PrecioUnitario</th>
                        <th>Subtotal</th>
                        <th>Factura</th>
                        <th>Producto</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.PrecioUnitario</td>
                                <td>@elemento.Subtotal</td>
                                <td>@elemento._Factura?.Total</td>
                                <td>@elemento._Producto?.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
