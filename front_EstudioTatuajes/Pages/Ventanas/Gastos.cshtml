@page
@model GastosModel
@{
    ViewData["Title"] = "Gastos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Gastos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flDescripcion"
                   placeholder="Descripcion"
                   asp-for="@Model.Filtro!.Descripcion" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Gastos</h3>

                <label>
                    Valor
                </label>
                <input asp-for="@Model.Actual!.Valor" />
                <br />

                <label>
                    Descripcion
                </label>
                <input asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Fecha
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Categoria
                </label>
                <input asp-for="@Model.Actual!.Categoria" />
                <br />

                <label>
                    Sede -Nombre
                </label>
                <select id="nmSede"
                        asp-for="@Model.Actual!.Sede"
                        asp-items="@(new SelectList(Model.Sedes, "Id", "Nombre"))">
                </select>
                <br />

                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Gasto con información ID:
                        @Model.Actual!.Id,
                        Descripcion @Model.Actual!.Descripcion,
                        Valor @Model.Actual!.Valor?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Valor </th>
                        <th>Descripcion</th>
                        <th>Fecha</th>
                        <th>Categoria</th>
                        <th>Sede</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Valor</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Categoria</td>
                                <td>@elemento._Sede.Nombre</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>