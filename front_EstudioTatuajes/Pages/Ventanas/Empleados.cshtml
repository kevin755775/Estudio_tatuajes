@page
@model EmpleadosModel
@{
    ViewData["Title"] = "Empleados";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Empleados</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flCargo"
                   placeholder="Cargo"
                   asp-for="@Model.Filtro!.Cargo" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Empleados</h3>

                <label>
                    Cargo
                </label>
                <input asp-for="@Model.Actual!.Cargo" />
                <br />

                <label>
                    Salario
                </label>
                <input asp-for="@Model.Actual!.Salario" />
                <br />

                <label>
                    Fecha de Ingreso
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.FechaIngreso" />
                <br />

                <label>
                    Sede -Nombre
                </label>
                <select id="nmSede"
                        asp-for="@Model.Actual!.Sede"
                        asp-items="@(new SelectList(Model.Sedes, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Persona -Nombre
                </label>
                <select id="nmPersona"
                        asp-for="@Model.Actual!.Persona"
                        asp-items="@(new SelectList(Model.Personas, "Id", "Nombre"))">
                </select>
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Empleado con información ID:
                        @Model.Actual!.Id,
                        Cargo @Model.Actual!.Cargo,
                        Salario @Model.Actual!.Salario?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Cargo </th>
                        <th>Salario</th>
                        <th>FechaIngreso</th>
                        <th>Sede</th>
                        <th>Persona</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Cargo</td>
                                <td>@elemento.Salario</td>
                                <td>@elemento.FechaIngreso</td>
                                <td>@elemento._Sede?.Nombre</td>
                                <td>@elemento._Persona?.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
