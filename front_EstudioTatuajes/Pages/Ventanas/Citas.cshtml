@page
@model CitasModel
@{
    ViewData["Title"] = "Citas";
    var rol = HttpContext.Session.GetString("Rol");
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Citas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            @if (rol == "Administrador" || rol == "Recepcionista")
            {
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar" />
            }
            
            <input id="flEstado"
                   placeholder="Estado"
                   asp-for="@Model.Filtro!.Estado" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cita</h3>

                <label>
                    Fecha 
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.FechaHora" />
                <br />

                <label>
                    Estado
                </label>
                <input asp-for="@Model.Actual!.Estado" />
                <br />

                <label>
                    Tatuaje -ZonaCuerpo
                </label>
                <select id="nmTatuaje"
                        asp-for="@Model.Actual!.Tatuaje"
                        asp-items="@(new SelectList(Model.Tatuajes, "Id", "ZonaCuerpo"))">
                </select>
                <br />

                <label>
                    Consentimiento - Firmo Si o No
                </label>
                <select id="nmConsentimiento"
                        asp-for="@Model.Actual!.Consentimiento"
                        asp-items="@(new SelectList(Model.Consentimientos, "Id", "FirmaSiNo"))">
                </select>
                <br />

                <label>
                    Factura -Total
                </label>
                <select id="nmFactura"
                        asp-for="@Model.Actual!.Factura"
                        asp-items="@(new SelectList(Model.Facturas, "Id", "Total"))">
                </select>
                <br />

                <label>
                    Sede -Nombre
                </label>
                <select id="nmSede"
                        asp-for="@Model.Actual!.Sede"
                        asp-items="@(new SelectList(Model.Sedes, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Cliente -Nombre
                </label>
                <select id="nmCliente"
                        asp-for="@Model.Actual!.Cliente"
                        asp-items="@(new SelectList(Model.Clientes, "Id", "_Persona.Nombre"))">
                </select>
                <br />

                <label>
                    Tatuador -Nombre
                </label>
                <select id="nmTatuador"
                        asp-for="@Model.Actual!.Tatuador"
                        asp-items="@(new SelectList(Model.Tatuadores, "Id", "_Persona.Nombre"))">
                </select>
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la cita con información ID:
                        @Model.Actual!.Id,
                        Fecha: @Model.Actual!.FechaHora,
                        Estado: @Model.Actual!.Estado?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Fecha </th>
                        <th>Estado</th>
                        <th>Tatuaje</th>
                        <th>Consentimiento</th>
                        <th>Factura</th>
                        <th>Sede</th>
                        <th>Cliente</th>
                        <th>Tatuador</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.FechaHora</td>
                                <td>@elemento.Estado</td>
                                <td>@elemento._Tatuaje.ZonaCuerpo</td>
                                <td>@elemento._Consentimiento.FirmaSiNo</td>
                                <td>@elemento._Factura.Total</td>
                                <td>@elemento._Sede.Nombre</td>
                                <td>@elemento._Cliente._Persona.Nombre</td>
                                <td>@elemento._Tatuador._Persona.Nombre</td>
                                <td>
                                    @if (rol == "Administrador" || rol == "Recepcionista")
                                    {
                                        <input type="submit"
                                               value="Editar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                    @if (rol == "Administrador")
                                    {
                                        <input type="submit"
                                               value="Borrar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>