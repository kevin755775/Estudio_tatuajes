@page
@model CitasModel
@{
    ViewData["Title"] = "Citas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Citas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flEstado"
                   placeholder="Estado"
                   asp-for="@Model.Filtro!.Estado" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cita</h3>

                <label>
                    Fecha y Hora
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.FechaHora" />
                <br />

                <label>
                    Estado
                </label>
                <input asp-for="@Model.Actual!.Estado" />
                <br />

                <label>
                    Tatuaje (ID)
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.Tatuaje" />
                <br />

                <label>
                    Consentimiento (ID)
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.Consentimiento" />
                <br />

                <label>
                    Factura (ID)
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.Factura" />
                <br />

                <label>
                    Sede (ID)
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.Sede" />
                <br />

                <label>
                    Cliente (ID)
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.Cliente" />
                <br />

                <label>
                    Tatuador (ID)
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.Tatuador" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la cita con información ID:
                        @Model.Actual!.Id,
                        Fecha: @Model.Actual!.FechaHora,
                        Estado: @Model.Actual!.Estado?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Fecha y Hora</th>
                        <th>Estado</th>
                        <th>Cliente</th>
                        <th>Tatuador</th>
                        <th>Sede</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.FechaHora</td>
                                <td>@elemento.Estado</td>
                                <td>@elemento.Cliente</td>
                                <td>@elemento.Tatuador</td>
                                <td>@elemento.Sede</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>