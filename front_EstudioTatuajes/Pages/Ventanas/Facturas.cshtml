@page
@model FacturasModel
@{
    ViewData["Title"] = "Facturas";
    var rol = HttpContext.Session.GetString("Rol");
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Facturas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            @if (rol == "Administrador" || rol == "Recepcionista")
            {
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar" />
            }
            <input id="flTotal"
                   placeholder="Total"
                   asp-for="@Model.Filtro!.Total" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Facturas</h3>

                <label>
                    Fecha
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Hora
                </label>
                <input asp-for="@Model.Actual!.Hora" />
                <br />

                <label>
                    Total
                </label>
                <input asp-for="@Model.Actual!.Total" />
                <br />

                <label>
                    IVA
                </label>
                <input asp-for="@Model.Actual!.IVA" />
                <br />

                <label>
                    Pago -Referencia
                </label>
                <select id="nmPago"
                        asp-for="@Model.Actual!.Pago"
                        asp-items="@(new SelectList(Model.Pagos, "Id", "Referencia"))">
                </select>
                <br />

                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la Factura con información ID:
                        @Model.Actual!.Id,
                        Total @Model.Actual!.Total,
                        Fecha @Model.Actual!.Fecha?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Fecha </th>
                        <th>Hora</th>
                        <th>Total </th>
                        <th>IVA</th>
                        <th>Pago</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Hora</td>
                                <td>@elemento.Total</td>
                                <td>@elemento.IVA</td>
                                <td>@elemento._Pago.Referencia</td>

                                <td>
                                    @if (rol == "Administrador" || rol == "Recepcionista")
                                    {
                                        <input type="submit"
                                               value="Editar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                    @if (rol == "Administrador")
                                    {
                                        <input type="submit"
                                               value="Borrar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>