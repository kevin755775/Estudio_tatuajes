@page
@model SesionesModel
@{
    ViewData["Title"] = "Sesiones";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Sesiones</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flNroSesion"
                   placeholder="NroSesion"
                   asp-for="@Model.Filtro!.NroSesion" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Sesiones</h3>

                <label>
                    NroSesion
                </label>
                <input type="number"
                       asp-for="@Model.Actual!.NroSesion" />
                <br />

                <label>
                    DuracionHrs
                </label>
                <input type="number" step="0.01"
                       asp-for="@Model.Actual!.DuracionHrs" />
                <br />

                <label>
                    FechaInicio
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.FechaInicio" />
                <br />

                <label>
                    Tatuaje -ZonaCuerpo
                </label>
                <select id="Tatuaje"
                        asp-for="@Model.Actual!.Tatuaje"
                        asp-items="@(new SelectList(Model.Tatuajes, "Id", "ZonaCuerpo"))">
                </select>
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la sesion con información ID:
                        @Model.Actual!.Id,
                        Fecha: @Model.Actual!.FechaInicio
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>NroSesion </th>
                        <th>DuracionHrs</th>
                        <th>FechaInicio</th>
                        <th>Tatuaje</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.NroSesion</td>
                                <td>@elemento.DuracionHrs</td>
                                <td>@elemento.FechaInicio</td>
                                <td>@elemento._Tatuaje.ZonaCuerpo</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>