@page
@model PortafoliosModel
@{
    ViewData["Title"] = "Portafolios";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Portafolios</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flTitulo"
                   placeholder="Titulo"
                   asp-for="@Model.Filtro!.Titulo" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Portafolios</h3>

                <label>
                    Titulo
                </label>
                <input asp-for="@Model.Actual!.Titulo" />
                <br />

                <label>
                    Descripcion
                </label>
                <input asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Fecha Ultima Actualizacion
                </label>
                <input type="datetime-local"
                       asp-for="@Model.Actual!.FechaUltAct" />
                <br />

                <label>
                    Total Diseños
                </label>
                <input asp-for="@Model.Actual!.TotalDisenos" />
                <br />
                <label>
                    Imagen Portafolios
                </label>
                @if (Model.Actual!.ImagenPortafolios != null)
                {
                    <img height="100"
                         width="100"
                         src="data:image;base64,
                    @System.Convert.ToBase64String(
                     Convert.FromBase64String(
                     Model.Actual!.ImagenPortafolios))" />
                }
                <input type="file"
                       asp-for="FormFile" />
                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Portafolio con información ID:
                        @Model.Actual!.Id,
                        Titulo @Model.Actual!.Titulo,
                        Descripcion @Model.Actual!.Descripcion?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>ID</th>
                        <th>Titulo </th>
                        <th>Descripcion</th>
                        <th>FechaUltAct</th>
                        <th>TotalDisenos</th>
                        <th>ImagenPortafolios</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Titulo</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.FechaUltAct</td>
                                <td>@elemento.TotalDisenos</td>
                                <td>
                                    @if (elemento.ImagenPortafolios != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                        @System.Convert.ToBase64String(
                                        Convert.FromBase64String(elemento.ImagenPortafolios))" />
                                    }
                                </td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>